<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_seta_voltar"
            android:background="@android:color/transparent"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="70dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro do Professor"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Utilize seu e-mail institucional para criar sua conta."
            android:textColor="#BDBDBD"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="45dp"/>

        <EditText
            android:id="@+id/etEmailInstitucional"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="Email Institucional"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="20dp"
            android:inputType="textEmailAddress"/>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="18dp"/>

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="Senha"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="20dp"
            android:inputType="textPassword"/>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="18dp"/>

        <EditText
            android:id="@+id/etConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="Confirmar senha"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="20dp"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnCadastrarProfessor"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#001B5E"
            android:layout_marginTop="40dp"
            android:backgroundTint="#FFD600"/>

    </LinearLayout>

</ScrollView>