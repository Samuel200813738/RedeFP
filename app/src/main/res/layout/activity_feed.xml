<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#00112E"

    android:fitsSystemWindows="false"

    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- CABEÇALHO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="135dp"

        android:layout_alignParentTop="true">

        <!-- FUNDO -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:src="@drawable/header_bg"

            android:scaleType="fitXY"/>
    </FrameLayout>

    <!-- CONTEÚDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- TOPO (MANTIDO COM A LOGO MAIOR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginTop="4dp">

            <!-- LOGO (PERMANECE GRANDE E CENTRALIZADA) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:src="@drawable/logo_redefpfeed"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"/>

            <!-- NOTIFICAÇÃO -->
            <ImageButton
                android:id="@+id/btnNotificacao"
                android:layout_width="48dp"
                android:layout_height="48dp"

                android:src="@drawable/ic_notification"

                android:background="@android:color/transparent"

                android:contentDescription="Notificações"

                android:scaleType="fitCenter"/>
        </LinearLayout>


        <!-- ABAS (ALINHADAS AO FINAL DO HEADER DE 135DP - AGORA COM 3 ITENS) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="-28dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:background="@android:color/transparent">

            <!-- PARA VOCÊ -->
            <TextView
                android:id="@+id/tabParaVoce"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Para você"
                android:textColor="#FFD600"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/tab_selected_bg"/>

            <!-- TURMAS -->
            <TextView
                android:id="@+id/tabTurmas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"

                android:text="Turmas"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@android:color/transparent"/>

            <!-- TUDO -->
            <TextView
                android:id="@+id/tabTudo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Tudo"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@android:color/transparent"/>

        </LinearLayout>


        <!-- CARD POST -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"

            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="22dp"

            android:background="@drawable/input_bg"

            android:elevation="3dp"

            android:clipToOutline="true"
            android:outlineProvider="background">

            <!-- AVATAR -->
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/user_profile"
                android:padding="8dp"
                android:background="@drawable/input_bg"
                android:contentDescription="Avatar"
                app:tint="#FFD600"/>

            <!-- CONTEÚDO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <EditText
                    android:id="@+id/etPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="O que você precisa avisar?"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9CA3AF"
                    android:textSize="15sp"
                    android:padding="0dp"
                    android:background="@android:color/transparent"/>

                <!-- LINHA DOS BOTÕES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnImagem"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_image_yellow" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnPostar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:backgroundTint="#FFD600"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="#000000" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- FEED -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPosts"

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"

            android:layout_marginTop="10dp"

            android:paddingBottom="100dp"

            android:clipToPadding="false"
            android:clipChildren="false"

            android:overScrollMode="never"/>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"

        android:layout_width="66dp"
        android:layout_height="66dp"

        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"

        android:layout_margin="16dp"

        android:translationY="-8dp"

        android:src="@android:drawable/ic_input_add"

        android:contentDescription="Adicionar"

        app:tint="#000000"
        app:backgroundTint="#FFD600"/>

    <!-- NAVBAR -->
    <LinearLayout
        android:id="@+id/bottomNav"

        android:layout_width="match_parent"
        android:layout_height="78dp"

        android:layout_alignParentBottom="true"

        android:background="#00153D"

        android:gravity="center"

        android:orientation="horizontal"

        android:elevation="20dp"

        android:paddingBottom="6dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"

                android:src="@drawable/ic_home"

                android:adjustViewBounds="true"
                android:scaleType="centerInside"

                app:tint="#FFD600"/>

            <TextView
                android:id="@+id/textHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Início"

                android:textColor="#FFD600"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- BUSCAR -->
        <LinearLayout
            android:id="@+id/navBuscar"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconBuscar"

                android:layout_width="22dp"
                android:layout_height="22dp"

                android:src="@drawable/ic_search"

                app:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/textBuscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Buscar"

                android:textColor="#FFFFFF"

                android:textSize="12sp"/>
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navEu"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconEu"

                android:layout_width="30dp"
                android:layout_height="30dp"

                android:src="@drawable/user_profile"

                app:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/textEu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Eu"

                android:textColor="#FFFFFF"

                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>