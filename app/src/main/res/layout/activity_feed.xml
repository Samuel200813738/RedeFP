<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#001B4A"

    android:fitsSystemWindows="false"

    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- CABEÇALHO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="175dp"

        android:layout_alignParentTop="true">

        <!-- FUNDO -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:src="@drawable/header_bg"

            android:scaleType="fitXY"/>

    </FrameLayout>

    <!-- CONTEÚDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:paddingTop="4dp"

        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- TOPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:layout_marginTop="2dp"

            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- MENU -->
            <ImageButton
                android:id="@+id/btnMenu"

                android:layout_width="38dp"
                android:layout_height="38dp"

                android:src="@android:drawable/ic_menu_sort_by_size"

                android:background="@android:color/transparent"

                android:contentDescription="Menu"

                app:tint="#FFFFFF"/>

            <!-- LOGO -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="78dp"

                android:layout_weight="1"

                android:src="@drawable/logo_redefpfeed"

                android:adjustViewBounds="true"

                android:scaleType="fitCenter"/>

            <!-- NOTIFICAÇÃO -->
            <ImageButton
                android:id="@+id/btnNotificacao"

                android:layout_width="38dp"
                android:layout_height="38dp"

                android:src="@android:drawable/ic_dialog_info"

                android:background="@android:color/transparent"

                android:contentDescription="Notificações"

                app:tint="#FFFFFF"/>
        </LinearLayout>

        <!-- ABAS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="-8dp"

            android:scrollbars="none"

            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tabParaVoce"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Para você"

                    android:textColor="#FFD600"
                    android:textStyle="bold"

                    android:textSize="17sp"

                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"/>

                <TextView
                    android:id="@+id/tabSeguindo"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Seguindo"

                    android:textColor="#FFFFFF"

                    android:textSize="17sp"

                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"/>

                <TextView
                    android:id="@+id/tabTurmas"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Turmas"

                    android:textColor="#FFFFFF"

                    android:textSize="17sp"

                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"/>

                <TextView
                    android:id="@+id/tabTudo"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Tudo"

                    android:textColor="#FFFFFF"

                    android:textSize="17sp"

                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- CARD POST -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:padding="14dp"

            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"

            android:background="@drawable/input_bg"

            android:elevation="4dp"

            android:clipToOutline="true">

            <!-- AVATAR -->
            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"

                android:src="@drawable/ic_user"

                android:padding="10dp"

                android:background="@drawable/input_bg"

                android:contentDescription="Avatar"

                app:tint="#FFD600"/>

            <!-- INPUT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical"

                android:layout_marginStart="12dp">

                <EditText
                    android:id="@+id/etPost"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:hint="O que você precisa avisar?"

                    android:textColor="#FFFFFF"
                    android:textColorHint="#9CA3AF"

                    android:textSize="17sp"

                    android:padding="0dp"

                    android:background="@android:color/transparent"/>

                <!-- BOTÃO -->
                <ImageButton
                    android:id="@+id/btnPostar"

                    android:layout_width="52dp"
                    android:layout_height="52dp"

                    android:layout_gravity="end"

                    android:layout_marginTop="8dp"

                    android:src="@android:drawable/ic_menu_send"

                    android:backgroundTint="#FFD600"

                    android:padding="12dp"

                    android:contentDescription="Postar"

                    app:tint="#000000"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FEED -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPosts"

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"

            android:layout_marginTop="6dp"

            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="110dp"

            android:clipToPadding="false"
            android:clipChildren="false"

            android:overScrollMode="never"/>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"

        android:layout_width="72dp"
        android:layout_height="72dp"

        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"

        android:layout_margin="16dp"

        android:translationY="-8dp"

        android:src="@android:drawable/ic_input_add"

        android:contentDescription="Adicionar"

        app:tint="#000000"
        app:backgroundTint="#FFD600"/>

    <!-- NAVBAR -->
    <LinearLayout
        android:id="@+id/bottomNav"

        android:layout_width="match_parent"
        android:layout_height="82dp"

        android:layout_alignParentBottom="true"

        android:background="#00153D"

        android:gravity="center"

        android:orientation="horizontal"

        android:elevation="20dp"

        android:paddingBottom="8dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@android:drawable/ic_menu_view"

                app:tint="#FFD600"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Início"

                android:textColor="#FFD600"

                android:textSize="13sp"/>
        </LinearLayout>

        <!-- BUSCAR -->
        <LinearLayout
            android:id="@+id/navBuscar"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@android:drawable/ic_menu_search"

                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Buscar"

                android:textColor="#FFFFFF"

                android:textSize="13sp"/>
        </LinearLayout>

        <!-- MENSAGENS -->
        <LinearLayout
            android:id="@+id/navMensagens"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@android:drawable/ic_dialog_email"

                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Mensagens"

                android:textColor="#FFFFFF"

                android:textSize="13sp"/>
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navEu"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"

                android:src="@drawable/ic_user"

                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Eu"

                android:textColor="#FFFFFF"

                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>