<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FUNDO -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#031633"/>

            <corners android:radius="18dp"/>

            <stroke
                android:width="1dp"
                android:color="#123768"/>
        </shape>
    </item>

    <!-- EFEITO SUPERIOR DIREITO -->
    <item
        android:top="0dp"
        android:right="0dp">

        <bitmap
            android:src="@drawable/post_effect_bg"
            android:gravity="top|right"/>
    </item>

</layer-list>